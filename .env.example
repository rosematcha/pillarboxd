# Postgres connection string. With docker-compose this is derived from
# POSTGRES_PASSWORD; set it directly for local dev against your own Postgres.
DATABASE_URL=postgres://pillarboxd:changeme@localhost:5432/pillarboxd

# Password for the compose-managed Postgres.
POSTGRES_PASSWORD=changeme

# 32+ random characters. Generate with: openssl rand -base64 33
BETTER_AUTH_SECRET=

# Public origin of this instance, no trailing slash.
APP_URL=http://localhost:5173

# TMDB API read access token (the long v4 bearer token, not the v3 key).
# Free for non-commercial use: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
